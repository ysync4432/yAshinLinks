rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == "COLE_SEU_UID";
    }
    match /cats/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /groups/{id} { allow read: if true; allow write: if isAdmin(); }
    match /meta/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /stats/{id} {
      allow read: if true;
      allow create: if isAdmin()
        || (request.resource.data.keys().hasOnly(['k']) && request.resource.data.k == 1)
        || (request.resource.data.keys().hasOnly(['visits']) && request.resource.data.visits == 1);
      allow update: if isAdmin()
        || (request.resource.data.keys().hasOnly(['k']) && request.resource.data.k == resource.data.k + 1)
        || (request.resource.data.keys().hasOnly(['visits']) && request.resource.data.visits == resource.data.visits + 1);
      allow delete: if isAdmin();
    }
  }
}
